{
  "mcpServers": {
    "project4agents": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://up-project4agents.vercel.app/api/mcp",
        "--header",
        "Authorization:${P4A_AUTH}"
      ],
      "env": {
        "P4A_AUTH": "Bearer ${P4A_API_TOKEN}"
      }
    }
  }
}
