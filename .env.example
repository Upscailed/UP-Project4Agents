# Kopieer naar .env.local en vul in
# (.env.local staat in .gitignore — geheimen blijven lokaal)

# Webhook secret — gegenereerd door scripts/setup-github-webhook.sh
GITHUB_WEBHOOK_SECRET=

# Default repo voor /api/github/sync (optioneel, kan ook autodetect via remote)
GITHUB_REPO=Upscailed/UP-Project4Agents

# MCP-server backend URL (default: http://localhost:3400/api)
P4A_API=http://localhost:3400/api

# API-token voor MCP-server / cron-jobs / CLI (Bearer auth, alternatief voor cookie-login)
# Genereer met: openssl rand -hex 32
P4A_API_TOKEN=

# Session secret voor cookie-encryptie (verplicht in productie)
# Genereer met: openssl rand -hex 32 (minimaal 32 chars)
SESSION_SECRET=

# GitHub OAuth (optioneel) — maak een app op https://github.com/settings/applications/new
# Callback URL: http://localhost:3400/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
