{
  "name": "up-project4agents",
  "description": "Project management voor AI agents — Kanban + REST API + GitHub-integratie + MCP server",
  "version": "0.2.0",
  "baseUrl": "http://localhost:3400/api",
  "mcp_install": {
    "local_project": "Plaats het meegeleverde .mcp.json in je werkmap (al gedaan in deze repo). Claude Code laadt 'm automatisch zodra je in deze repo werkt.",
    "global": "claude mcp add project4agents node /pad/naar/UP-Project4Agents/scripts/mcp-server.mjs",
    "manual_test": "node ./scripts/mcp-server.mjs (handshake via stdin/stdout)"
  },
  "tools": [
    { "name": "list_projects",   "description": "Lijst alle projecten op" },
    { "name": "create_project",  "description": "Maak een nieuw project" },
    { "name": "list_issues",     "description": "Lijst issues (filter op status/priority/assignee/cycle/search)" },
    { "name": "get_issue",       "description": "Haal één issue op (incl. sub-issues)" },
    { "name": "get_next_issue",  "description": "Volgende taak (hoogste prio, niet geblokkeerd)" },
    { "name": "claim_issue",     "description": "Atomic claim: status=in_progress + assignee + comment" },
    { "name": "create_issue",    "description": "Maak een nieuwe issue (sub-issues via parent_issue_id)" },
    { "name": "update_issue",    "description": "Werk een issue bij" },
    { "name": "delete_issue",    "description": "Verwijder een issue" },
    { "name": "add_comment",     "description": "Voeg comment toe (activity log)" },
    { "name": "list_comments",   "description": "Comments van een issue" },
    { "name": "get_branch_name", "description": "Branch-naam suggestie (prefix/up-42-slug)" },
    { "name": "link_issues",     "description": "Link twee issues (blocks/blocked_by/relates_to/duplicates)" },
    { "name": "get_issue_links", "description": "Lijst links van een issue" },
    { "name": "list_cycles",     "description": "Lijst cycles (sprints)" },
    { "name": "create_cycle",    "description": "Maak een nieuwe cycle aan" },
    { "name": "get_activity",    "description": "Activity log van issue/project" },
    { "name": "list_views",      "description": "Lijst opgeslagen views/filters" },
    { "name": "get_stats",       "description": "Statistieken" },
    { "name": "sync_github",     "description": "Manual sync — haalt PRs op via gh CLI en past statussen aan" }
  ]
}
